// {"id": "q001", "type": "procedure", "category": "manuals", "question": "What are the transportation and storage guidelines for ABB motors?", "evidence": [{"source": "abb_ex_motors_iom_2007", "pages": [6], "contains": "In other conditions, please contact ABB"}], "answer": "The motor should always be stored indoors (above 20°C), in dry, vibration free and dust free conditions. During transportation, shocks, falls and humidity should be avoided. In other conditions, please contact ABB. Unprotected machined surfaces (shaft-ends and flanges) should be treated against corrosion. It is recommended that shafts are rotated periodically by hand to prevent grease migration. Anti-condensation heaters, if fitted, are recommended to avoid water condensing in the motor."}
// {"id": "q002", "type": "procedure", "category": "manuals", "question": "What is the general warning with respect to lubricants containing EP admixtures?", "evidence": [{"source": "abb_lv_motors_iom_2009", "pages": [17], "contains": " EP admixtures"}], "answer": "Lubricants containing EP admixtures are not recommended in high bearing temperatures in frame sizes 280 to 450."}
{"id": "q003", "type": "table_lookup", "category": "manuals", "question": "Size of Equipment Ground Conductor (For IEC)?", "evidence": [{"source": "baldor_mn431_iom", "pages": [15], "contains": "Cross sectional area of phase conductors, S"}], "answer": {"type": "table", "columns": ["phase_conductor", "protective_conductor"], "rows": [{"phase_conductor": "S ≤ 16 mm²", "protective_conductor": "S"}, {"phase_conductor": "16 mm² < S ≤ 35 mm²", "protective_conductor": "16 mm²"}, {"phase_conductor": "S > 35 mm²", "protective_conductor": "S / 2"}]}}
// {"id": "q004", "type": "numeric_spec", "category": "manuals", "question": "What minimum megohmmeter reading does Toshiba recommend before applying power to a stored motor?", "evidence": [{"source": "toshiba_lv_induction_motor_iom", "pages": [15], "contains": "minimum of 10 megohms"}], "answer": "At least 10 megohms."}
// {"id": "q005", "type": "colloquial", "category": "manuals", "question": "can I just mix whatever grease I have in the store when greasing the motor bearings?", "evidence": [{"source": "siemens_horizontal_induction_motor_iom", "pages": [61], "contains": "does not recommend mixing"}], "answer":"Greases should not be combined or mixed. Siemens does not recommend mixing two greases even if compatible of the two greases has been verified."}
// {"id": "q006", "type": "numeric_spec", "category": "manuals", "question": "What minimum insulation resistance does ABB require for low voltage motors, and at what reference temperature?", "evidence": [{"source": "abb_lv_motors_iom_2009", "pages": [7], "contains": "corrected to 25"}], "answer": "Above the 100 MOhm reference value, corrected to 25 C and measured with 500 or 1000 V DC; the value halves for every 20 C rise in temperature."}
// {"id": "q007", "type": "procedure", "category": "manuals", "question": "How should a damp ABB motor winding be oven dried when the insulation resistance is too low?", "evidence": [{"source": "abb_lv_motors_iom_2009", "pages": [7], "contains": "oven dried"}], "answer": "Oven dry at 90 C for 12-16 hours, then 105 C for 6-8 hours, with drain hole plugs removed."}
// {"id": "q008", "type": "vendor_specific", "category": "manuals", "question": "How often should insulation resistance be tested on a Brook Crompton motor in extended storage, and what value should be maintained?", "evidence": [{"source": "brook_crompton_td103_maintenance", "pages": [4], "contains": "three monthly"}], "answer": "Every three months with a 500 V DC Megger, between phases and windings to frame; keep it above 10 MOhm, otherwise dry out per page E6."}
// {"id": "q009", "type": "numeric_spec", "category": "manuals", "question": "What insulation resistance is typically sufficient for a Hyosung low-voltage motor stator winding, and at what winding temperature?", "evidence": [{"source": "hyosung_nema_lv_motor_om", "pages": [12], "contains": "IEEE Std 43"}], "answer": "5 MOhm or more at a winding temperature of 104 F, measured with a 500 V DC tester; correct for temperature per IEEE Std 43."}
{"id": "q010", "type": "numeric_spec", "category": "manuals", "question": "What temperature and humidity limits does Baldor specify for storing motors?", "evidence": [{"source": "baldor_mn431_iom", "pages": [7], "contains": "Relative humidity must not exceed"}], "answer": "10 C (50 F) to 49 C (120 F), relative humidity no more than 60%, and shock or vibration under 2 mils at 60 Hz."}
{"id": "q011", "type": "vendor_specific", "category": "manuals", "question": "How often should winding insulation resistance be measured on a Baldor motor in storage?", "evidence": [{"source": "baldor_mn431_iom", "pages": [7], "contains": "every 30 days"}], "answer": "Every 30 days of storage; if it falls below the minimum, contact the Baldor district office."}
// {"id": "q012", "type": "procedure", "category": "manuals", "question": "What checks should be done before starting a Toshiba low voltage motor for the first time?", "evidence": [{"source": "toshiba_lv_induction_motor_iom", "pages": [16], "contains": "bearing lock plate"}, {"source": "toshiba_lv_induction_motor_iom", "pages": [23], "contains": "before the initial start up"}], "answer": "Pre-check (p23): inspect for foreign material and cleanliness, ensure the motor is dry, etc.; plus the start-up list (p16): nameplate vs order, transport damage, remove bearing lock plate, turn shaft by hand, megohmmeter test."}
// {"id": "q013", "type": "table_lookup", "category": "manuals", "question": "What is the maximum surface temperature allowed for temperature class T4 motors in explosive atmospheres?", "evidence": [{"source": "abb_ex_motors_iom_2007", "pages": [6], "contains": "Temperature class"}], "answer": "135 C (maximum surface temperature rise 90 K at 40 C ambient)."}
// {"id": "q014", "type": "definition", "category": "manuals", "question": "Which ABB motor series are covered for flameproof enclosure Ex d and Ex de?", "evidence": [{"source": "abb_ex_motors_iom_2007", "pages": [5], "contains": "Flameproof"}], "answer": "Series M2J*/M3J* and M2K*/M3K*, sizes 80 to 400."}
// {"id": "q015", "type": "vendor_specific", "category": "manuals", "question": "Why must the axial force never change direction on Ex d motors with angular contact bearings?", "evidence": [{"source": "abb_ex_motors_iom_2007", "pages": [7], "contains": "angular contact"}], "answer": "The flameproof gaps around the shaft change dimensions and may even close to contact."}
// {"id": "q016", "type": "procedure", "category": "manuals", "question": "How do I avoid bearing currents when running an ABB motor from an ACS800 frequency converter?", "evidence": [{"source": "abb_lv_motors_iom_2009", "pages": [12], "contains": "bearing currents"}, {"source": "abb_ex_motors_iom_2007", "pages": [13], "contains": "bearing currents"}], "answer": "Use insulated bearings or bearing constructions, common mode filters and suitable cabling and grounding, chosen by nominal power / frame size per the ABB table."}
// {"id": "q017", "type": "numeric_spec", "category": "manuals", "question": "How much grease per lubrication interval should be used when an ABB Ex motor has an automatic regreasing system?", "evidence": [{"source": "abb_ex_motors_iom_2007", "pages": [16], "contains": "doubled"}], "answer": "Double the amount stated in the table."}
// {"id": "q018", "type": "vendor_specific", "category": "manuals", "question": "Can two different greases be mixed when relubricating a Siemens horizontal induction motor?", "evidence": [{"source": "siemens_horizontal_induction_motor_iom", "pages": [61], "contains": "should not be combined or mixed"}], "answer": "No. Siemens does not recommend mixing greases even if their compatibility has been verified; use the grease on the lube plate."}
// {"id": "q019", "type": "numeric_spec", "category": "manuals", "question": "Roughly how heavy should the foundation be for a Siemens horizontal motor?", "evidence": [{"source": "siemens_horizontal_induction_motor_iom", "pages": [18], "contains": "2-1/2 times"}], "answer": "About 2.5 times the total weight of the motor, within the allowable bearing load of the support."}
// {"id": "q020", "type": "numeric_spec", "category": "manuals", "question": "How many starts are allowed for a Hyosung NEMA low voltage motor?", "evidence": [{"source": "hyosung_nema_lv_motor_om", "pages": [30], "contains": "HOT"}], "answer": "1 hot / 2 cold starts; for more frequent starting contact Hyosung."}
// {"id": "q021", "type": "vendor_specific", "category": "manuals", "question": "Where are Brook Crompton relubrication intervals given, and what do they mean for motors without grease nipples?", "evidence": [{"source": "brook_crompton_td103_maintenance", "pages": [6], "contains": "sealed for life"}], "answer": "In Appendix 2; for motors without nipples (sealed-for-life bearings) the intervals are bearing replacement recommendations."}
{"id": "q022", "type": "procedure", "category": "manuals", "question": "Should a high potential insulation test be done with the motor still connected to its drive?", "evidence": [{"source": "baldor_mn431_iom", "pages": [6], "contains": "High Potential"}], "answer": "No, disconnect the motor from any speed control or drive first to avoid damaging it."}
// {"id": "q023", "type": "numeric_spec", "category": "standards", "question": "By how much can the supply voltage and frequency vary while a motor must still deliver rated output under IS 325?", "evidence": [{"source": "is_325_1996_three_phase_induction_motors", "pages": [10], "contains": "rated output with"}], "answer": "Voltage within +/-6% of rated, frequency within +/-3%, or any combination of the two."}
// {"id": "q024", "type": "definition", "category": "standards", "question": "When is a three-phase supply considered a virtually balanced voltage system in IS 325?", "evidence": [{"source": "is_325_1996_three_phase_induction_motors", "pages": [9, 10], "contains": "negative sequence"}], "answer": "When the negative sequence component does not exceed 1% of the positive sequence component over a long period, or 1.5% for short periods of a few minutes."}
// {"id": "q025", "type": "numeric_spec", "category": "standards", "question": "Below what insulation resistance must a motor be dried out before applying full voltage according to IS 900?", "evidence": [{"source": "is_900_1992_induction_motor_installation_maintenance", "pages": [13], "contains": "dried out before full voltage"}], "answer": "Below 1 MOhm per kV of rated voltage, with a minimum of 1 MOhm, measured cold."}
// {"id": "q026", "type": "numeric_spec", "category": "standards", "question": "What is the maximum safe winding temperature while drying out a motor?", "evidence": [{"source": "is_900_1992_induction_motor_installation_maintenance", "pages": [13], "contains": "maximum safe temperature"}], "answer": "90 C measured by thermometer; heating must be continuous but not too low, or moisture is reabsorbed."}
// {"id": "q027", "type": "procedure", "category": "standards", "question": "How should motors be stored before installation according to IS 900?", "evidence": [{"source": "is_900_1992_induction_motor_installation_maintenance", "pages": [11], "contains": "clean and dry place"}], "answer": "In a clean dry place, keeping the anti-rust preservative on machined parts, with periodic examination and fresh preservation during long storage; protect from moisture, acid and alkali fumes."}
// {"id": "q028", "type": "definition", "category": "standards", "question": "Which IEC standard was IS 12615:2011 aligned with for motor efficiency classes?", "evidence": [{"source": "is_12615_2011_energy_efficient_motors", "pages": [5], "contains": "IEC 60034-30"}], "answer": "IEC 60034-30:2008 (efficiency classes of single-speed three-phase cage induction motors); test methods per IS 15999 (Part 2/Sec 1) / IEC 60034-2-1."}
// {"id": "q029", "type": "definition", "category": "standards", "question": "Which motors are excluded from the scope of IS 12615?", "evidence": [{"source": "is_12615_2011_energy_efficient_motors", "pages": [6], "contains": "converter duty"}], "answer": "Motors made only for converter duty, motors fully integrated into a machine that cannot be tested separately, and motors rated for duty S4 and above (with exceptions)."}
// {"id": "q030", "type": "numeric_spec", "category": "standards", "question": "How is full load current determined under IS 12615, and how does it change for a motor not rated at 415 V?", "evidence": [{"source": "is_12615_2011_energy_efficient_motors", "pages": [7], "contains": "inverse proportion"}], "answer": "Average of the currents in all three phases; for other rated voltages the maximum full load current changes in inverse proportion to the voltage."}
// {"id": "q031", "type": "definition", "category": "standards", "question": "What range of voltage and motor output does IS 900 cover?", "evidence": [{"source": "is_900_1992_induction_motor_installation_maintenance", "pages": [5], "contains": "11 kV"}], "answer": "Motors rated up to 11 kV with outputs from 60 kW to 250 kW (as stated in the foreword)."}
// {"id": "q032", "type": "cross_source", "category": "manuals", "question": "What minimum insulation resistance do different motor manufacturers and IS 900 recommend before energising a motor?", "evidence": [{"source": "abb_lv_motors_iom_2009", "pages": [7], "contains": "corrected to 25"}, {"source": "brook_crompton_td103_maintenance", "pages": [4], "contains": "10 megohm"}, {"source": "hyosung_nema_lv_motor_om", "pages": [12], "contains": "IEEE Std 43"}, {"source": "toshiba_lv_induction_motor_iom", "pages": [15], "contains": "minimum of 10 megohms"}, {"source": "is_900_1992_induction_motor_installation_maintenance", "pages": [13], "contains": "dried out before full voltage"}], "answer": "ABB: 100 MOhm at 25 C; Brook Crompton: 10 MOhm; Toshiba: 10 MOhm; Hyosung: 5 MOhm at 104 F; IS 900: 1 MOhm/kV, minimum 1 MOhm. Values differ, so cite the source."}
// {"id": "q033", "type": "colloquial", "category": "manuals", "question": "motor was sitting in a damp store for months and the megger reading is low, what do I do now?", "evidence": [{"source": "is_900_1992_induction_motor_installation_maintenance", "pages": [13], "contains": "dried out before full voltage"}, {"source": "abb_lv_motors_iom_2009", "pages": [7], "contains": "oven dried"}, {"source": "brook_crompton_td103_maintenance", "pages": [4], "contains": "drying out methods"}], "answer": "Do not energise; dry the winding out (oven, hot air or heaters) without exceeding about 90 C and recheck insulation resistance until it is above the minimum."}
// {"id": "q034", "type": "table_lookup", "category": "manuals", "question": "What reduction factor applies to WEG TGA/TGV bearing lubrication intervals when the bearing runs between 80 and 90 C?", "evidence": [{"source": "weg_t_line_induction_motor_iom", "pages": [33], "contains": "Reduction factor"}], "answer": "0.40 (intervals assume 70 C; 1.59 below 60 C, 0.63 at 70-80 C, 0.25 at 90-100 C, 0.16 at 100-110 C)."}
// {"id": "q035", "type": "vendor_specific", "category": "manuals", "question": "How often must WEG T-line motor bearings be relubricated at minimum?", "evidence": [{"source": "weg_t_line_induction_motor_iom", "pages": [33], "contains": "annually"}], "answer": "Annually, or at the interval on the bearing nameplate, whichever comes first."}
// {"id": "q036", "type": "procedure", "category": "guides", "question": "How do I estimate motor load from measured three-phase input power?", "evidence": [{"source": "doe_determining_motor_load_and_efficiency", "pages": [3], "contains": "Input power at full-rated load"}], "answer": "Load = Pi / Pir x 100%, where Pir = hp x 0.7457 / full-load efficiency."}
// {"id": "q037", "type": "procedure", "category": "guides", "question": "When is the slip method recommended for estimating motor load?", "evidence": [{"source": "doe_determining_motor_load_and_efficiency", "pages": [5], "contains": "slip method"}], "answer": "When only operating speed measurements are available; slip is proportional to load."}
// {"id": "q038", "type": "numeric_spec", "category": "guides", "question": "At what deviation from rated voltage is motor performance significantly affected?", "evidence": [{"source": "doe_motor_drive_sourcebook_2008_tip_sheets", "pages": [12], "contains": "rated voltage"}], "answer": "At +/-10% or more from rated voltage."}
// {"id": "q039", "type": "definition", "category": "guides", "question": "Do NEMA derating factors for voltage unbalance differ between standard and premium efficiency motors?", "evidence": [{"source": "doe_premium_efficiency_motor_handbook", "pages": [70], "contains": "derating factor"}], "answer": "No, the same NEMA derating factors apply to all motors."}
// {"id": "q040", "type": "numeric_spec", "category": "guides", "question": "Does rewinding a premium efficiency IE3 motor reduce its efficiency?", "evidence": [{"source": "easa_aemt_rewind_study", "pages": [6], "contains": "average efficiency change"}, {"source": "easa_aemt_rewind_study", "pages": [11], "contains": "ranged from"}], "answer": "Not when good practice (ANSI/EASA AR100) is followed: the average change was within the +/-0.2% test accuracy, individual changes from +0.3% to -0.5%."}
// {"id": "q041", "type": "numeric_spec", "category": "guides", "question": "How much efficiency can a motor lose if rewinding is not done properly?", "evidence": [{"source": "bee_book3_checklists_tips", "pages": [1], "contains": "rewinding is not done properly"}], "answer": "5-8% according to the BEE checklist."}
// {"id": "q042", "type": "cross_source", "category": "guides", "question": "Should a failed motor be rewound or replaced from an efficiency point of view?", "evidence": [{"source": "easa_aemt_rewind_study", "pages": [6], "contains": "average efficiency change"}, {"source": "bee_book3_checklists_tips", "pages": [1], "contains": "rewinding is not done properly"}], "answer": "Good-practice rewinds keep efficiency within about 0.2% (EASA), but poor rewinds lose 5-8% (BEE), so demand efficiency restoration or replace with an energy-efficient motor."}
// {"id": "q043", "type": "numeric_spec", "category": "guides", "question": "What power factor should a plant correct to under rated load conditions?", "evidence": [{"source": "bee_book3_checklists_tips", "pages": [1], "contains": "at least 0.90"}], "answer": "At least 0.90."}
// {"id": "q044", "type": "procedure", "category": "guides", "question": "What are the steps of an energy audit for motor driven systems?", "evidence": [{"source": "iea_4e_emsa_motor_system_audit_guide", "pages": [6], "contains": "Step 9"}], "answer": "1 acquisition and planning, 2 opening meeting, 3 data collection, 4 measurement plan, 5 site visit, 6 data analysis, 7 reporting, 8 closing meeting, 9 connection to energy management and motor policy."}
// {"id": "q045", "type": "table_lookup", "category": "drives", "question": "What does fault 2310 mean on an ABB ACS580 drive and what should I check?", "evidence": [{"source": "abb_acs580_firmware_manual", "pages": [420], "contains": "2310"}], "answer": "Overcurrent: output current exceeded the internal limit (also earth fault or supply phase loss); check motor load, acceleration ramps and the motor/cable."}
// {"id": "q046", "type": "procedure", "category": "drives", "question": "Can the ACS580 reset itself automatically after an overcurrent trip?", "evidence": [{"source": "abb_acs580_firmware_manual", "pages": [148], "contains": "Automatic fault resets"}], "answer": "Yes, after overcurrent, overvoltage, undervoltage and external faults, but automatic resets are off by default and must be activated."}
// {"id": "q047", "type": "numeric_spec", "category": "drives", "question": "What are the factory default ramp-up and ramp-down times on a SINAMICS G120 with CU240B/E-2?", "evidence": [{"source": "siemens_g120_cu240be2_operating_instructions", "pages": [87], "contains": "Ramp-up time"}], "answer": "10 s each (maximum speed factory setting 1500 rpm)."}
// {"id": "q048", "type": "colloquial", "category": "drives", "question": "motor on the G120 won't turn smoothly at very low speed with V/f control, what do I tweak?", "evidence": [{"source": "siemens_g120_cu240be2_operating_instructions", "pages": [174], "contains": "p1310"}], "answer": "Increase the voltage boost p1310 in small steps until it runs smoothly; too much boost overheats the motor and can trip on overcurrent."}
// {"id": "q049", "type": "definition", "category": "papers", "question": "At what frequencies do broken rotor bar components appear in the stator current spectrum?", "evidence": [{"source": "broken_rotor_bar_mcsa_survey", "pages": [3], "contains": "broken rotor bar"}], "answer": "At f1(1 +/- 2ks), k = 1, 2, 3, ...: sidebands at 2sf1 around the supply frequency."}
// {"id": "q050", "type": "numeric_spec", "category": "papers", "question": "At what sampling rates was the CWRU bearing vibration data recorded and on what motor?", "evidence": [{"source": "rotating_machinery_dl_benchmark_arxiv_2003.03315", "pages": [10], "contains": "12 kHz or 48 kHz"}, {"source": "multi_fault_rotating_machines_review_arxiv_2206.14153", "pages": [17], "contains": "Reliance"}], "answer": "12 kHz or 48 kHz, on a 2 hp Reliance Electric motor under four loads, with EDM-seeded single-point faults."}
// {"id": "q051", "type": "definition", "category": "papers", "question": "What test rig was used to create the MaFaulDa machinery fault dataset?", "evidence": [{"source": "mafaulda_cwru_kan_arxiv_2412.01322", "pages": [11], "contains": "SpectraQuest"}], "answer": "A SpectraQuest alignment/balance vibration trainer machinery fault simulator."}
// {"id": "q052", "type": "numeric_spec", "category": "bee_audits", "question": "How much petcoke can ceramic fibre insulation save in the Jodhpur limestone kilns?", "evidence": [{"source": "jodhpur_limestone_cluster_manual", "pages": [23], "contains": "saving potential"}], "answer": "At least 4%, by cutting batch time from 13 hours to 11-12 hours."}
